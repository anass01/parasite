# ===========================================================================
# Parasite — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and should NEVER be committed.

# PostgreSQL connection string (used by Next.js app AND Python pipeline)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/parasite
